---
const nav = [
  { href: '/', ja: 'ホーム' },
  { href: '/services/', ja: '事業内容' },
  { href: '/company/', ja: '会社概要' },
  { href: '/news/', ja: 'ニュース' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-line bg-white/85 backdrop-blur">
  <div class="mx-auto flex h-[72px] max-w-6xl items-center justify-between px-4 md:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="GRITTY ホーム">
      <img src="/images/logo-mark.png" alt="" class="h-9 w-auto" />
      <img src="/images/logo-navy.png" alt="GRITTY" class="h-[18px] w-auto" />
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="メインナビゲーション">
      {nav.map((n) => (
        <a href={n.href}
           class={`text-[15px] font-medium transition hover:text-teal ${path === n.href ? 'text-teal' : 'text-ink'}`}>
          {n.ja}
        </a>
      ))}
      <a href="/contact/" class="rounded-full bg-ink px-6 py-2.5 text-sm font-bold text-white transition hover:bg-teal">お問い合わせ</a>
    </nav>
    <button id="menu-btn" class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu">
      <span class="block h-0.5 w-6 bg-ink"></span>
      <span class="block h-0.5 w-6 bg-ink"></span>
      <span class="block h-0.5 w-6 bg-ink"></span>
    </button>
  </div>
  <div id="mobile-menu" class="hidden border-t border-line bg-white md:hidden">
    <nav class="flex flex-col px-4 py-3" aria-label="モバイルナビゲーション">
      {nav.map((n) => (
        <a href={n.href} class="border-b border-line py-3.5 text-ink">{n.ja}</a>
      ))}
      <a href="/contact/" class="mt-4 rounded-full bg-ink py-3 text-center font-bold text-white">お問い合わせ</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
