---
interface Props {
  en: string;
  ja: string;
  center?: boolean;
}
const { en, ja, center = false } = Astro.props;
---
<div class={`mb-12 ${center ? 'text-center' : ''}`}>
  <p class="font-en text-xs font-bold uppercase tracking-[0.2em] text-teal">{en}</p>
  <h2 class="mt-3 font-display text-[28px] font-bold leading-snug text-ink md:text-4xl">{ja}</h2>
</div>
