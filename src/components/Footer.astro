---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="bg-navy text-white">
  <div class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <div class="flex flex-col justify-between gap-10 md:flex-row md:items-start">
      <div>
        <a href="/" class="flex items-center gap-2.5">
          <img src="/images/logo-mark.png" alt="" class="h-9 w-auto" />
          <img src="/images/logo-white.png" alt="GRITTY" class="h-[18px] w-auto" />
        </a>
        <p class="mt-5 text-sm leading-relaxed text-white/60">
          {site.company_name}<br />
          {site.address}
        </p>
      </div>
      <nav class="flex gap-10 text-sm" aria-label="フッターナビゲーション">
        <div class="flex flex-col gap-3">
          <a href="/" class="text-white/80 hover:text-cyan">ホーム</a>
          <a href="/services/" class="text-white/80 hover:text-cyan">事業内容</a>
          <a href="/company/" class="text-white/80 hover:text-cyan">会社概要</a>
        </div>
        <div class="flex flex-col gap-3">
          <a href="/news/" class="text-white/80 hover:text-cyan">ニュース</a>
          <a href="/contact/" class="text-white/80 hover:text-cyan">お問い合わせ</a>
          <a href={site.line_url} target="_blank" rel="noopener" class="text-white/80 hover:text-cyan">公式LINE</a>
        </div>
      </nav>
    </div>
    <div class="mt-12 border-t border-white/10 pt-6 text-xs text-white/40">
      © {year} GRITTY Inc.
    </div>
  </div>
</footer>
