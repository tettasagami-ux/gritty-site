---
import { base, bookUrl, squareReady, title } from '../lib/gym';
const nav = [
  { href: `${base}menu/`, ja: 'メニュー・料金' },
  { href: `${base}trainer/`, ja: '所属トレーナー' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const cls = (href: string) => `transition hover:text-teal ${path === href ? 'text-teal' : 'text-ink'}`;
---
<header class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 md:h-[72px] md:px-6">
    <a href={base} class="flex items-center gap-2.5" aria-label={`${title} トップ`}>
      <img src="/images/logo-mark.png" alt="" class="h-7 w-auto md:h-9" />
      <span class="leading-none">
        <span class="block whitespace-nowrap font-en text-[15px] font-semibold tracking-[0.04em] text-ink md:text-xl md:tracking-[0.08em]">{title}</span>
        <span class="mt-1 hidden text-[10px] md:block tracking-wider text-ink/50">広島・安佐南｜パフォーマンスジム</span>
      </span>
    </a>
    <nav class="flex shrink-0 items-center gap-8" aria-label={`${title} メニュー`}>
      {nav.map((n) => (
        <a href={n.href} class={`hidden text-[15px] font-medium md:inline ${cls(n.href)}`} aria-current={path === n.href ? 'page' : undefined}>{n.ja}</a>
      ))}
      <a href={bookUrl} target="_blank" rel="noopener" class="whitespace-nowrap rounded-full bg-teal px-4 py-2 text-[13px] md:px-5 md:py-2.5 md:text-sm font-bold text-white transition hover:bg-ink">{squareReady ? '予約する' : 'LINEで予約'}</a>
    </nav>
  </div>
  <!-- スマホ用：2つのリンクを常に表示 -->
  <nav class="grid grid-cols-2 border-t border-line text-center text-sm font-bold md:hidden" aria-label={`${title} メニュー（スマホ）`}>
    {nav.map((n) => (
      <a href={n.href} class={`py-2.5 ${cls(n.href)} ${path === n.href ? 'bg-teal/5' : ''}`}>{n.ja}</a>
    ))}
  </nav>
</header>
