---
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
---
<Base title="クリエイティブ＆イベント" description="GRITTYのクリエイティブ＆イベント事業。スポーツ現場の映像制作、YouTubeチャンネル運営代行、イベント企画運営。">
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="font-en text-xl italic tracking-wide text-teal"><a href="/services/" class="hover:underline">Service</a> / Creative & Events</p>
      <h1 class="mt-4 font-display text-4xl font-bold text-ink md:text-5xl">クリエイティブ＆イベント</h1>
      <p class="mt-6 max-w-2xl leading-loose text-ink/70">
        測定・練習・試合など、スポーツ現場の熱量をそのまま伝える。企画から編集・運営まで一貫して担います。
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 md:grid-cols-2 md:px-6 md:py-28">
      <div>
        <img src="/images/service-creative.webp" alt="1000fpsハイスピードカメラで捉えたボールリリースの瞬間" class="mono w-full rounded-2xl object-cover" loading="lazy" />
      </div>
      <div class="space-y-8">
        {[
          { name: '動画制作', desc: '測定・練習・試合など、スポーツ現場の映像を企画から撮影・編集まで一貫して制作します。' },
          { name: 'YouTubeチャンネル運営', desc: 'チーム・スクール・企業のチャンネルを、企画・撮影・編集・分析まで含めて運営代行します。' },
          { name: 'イベント企画運営', desc: '測定会・野球教室・体験イベントなど、データとスポーツを掛け合わせたイベントを企画・運営します。' },
        ].map((p) => (
          <div class="border-t-2 border-teal pt-4">
            <h2 class="font-display text-lg font-bold text-ink">{p.name}</h2>
            <p class="mt-2.5 text-sm leading-relaxed text-ink/60">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactBand />
</Base>
