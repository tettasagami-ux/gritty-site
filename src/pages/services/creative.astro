---
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
---
<Base title="クリエイティブ＆イベント" description="GRITTYのクリエイティブ＆イベント事業。現在準備中です。">
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="font-en text-xl italic tracking-wide text-teal"><a href="/services/" class="hover:underline">Service</a> / Creative & Events</p>
      <h1 class="mt-4 font-display text-4xl font-bold text-ink md:text-5xl">クリエイティブ＆イベント</h1>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-4 py-28 text-center md:px-6 md:py-36">
      <p class="font-en text-4xl italic tracking-wide text-teal md:text-5xl">Coming Soon</p>
      <p class="mt-8 leading-loose text-ink/70">
        このページは現在準備中です。<br />
        サービス内容の詳細は、公開までしばらくお待ちください。
      </p>
      <a href="/services/" class="mt-10 inline-block rounded-full bg-ink px-10 py-3.5 font-bold text-white transition hover:bg-teal">事業内容一覧へ戻る</a>
    </div>
  </section>

  <ContactBand />
</Base>
