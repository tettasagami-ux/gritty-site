---
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
---
<Base title="デジタルソリューション" description="GRITTYのデジタルソリューション。野球の現場で使うアプリの自社開発と、チーム・スクールのデジタル導入支援。">
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="font-en text-xl italic tracking-wide text-teal"><a href="/services/" class="hover:underline">Service</a> / Digital Solutions</p>
      <h1 class="mt-4 font-display text-4xl font-bold text-ink md:text-5xl">デジタルソリューション</h1>
      <p class="mt-6 max-w-2xl leading-loose text-ink/70">
        現場で本当に使われるアプリを、自社で開発・運用。現場で得た知見をそのままプロダクトに還元しています。
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 md:grid-cols-2 md:px-6 md:py-28">
      <div>
        <img src="/images/service-digital.webp" alt="GRITTY DataBaseの投球分析ダッシュボード画面" class="w-full rounded-2xl border border-line object-cover" loading="lazy" />
      </div>
      <div class="space-y-8">
        {[
          { name: 'GRITTY DataBase', tag: '投球分析プラットフォーム', desc: '球速・回転数・変化量を可視化し、コーチと選手がデータで投球を最適化。セッションごとの時系列比較も。' },
          { name: 'GRITTY Training Management', tag: 'パフォーマンス管理', desc: 'コーチが選手ごとに練習メニューを割り当て、選手がリアルタイムで進捗を記録。' },
          { name: 'GRITTY Conditioning', tag: 'コンディション記録アプリ', desc: '体調・投球数・トレーニング量を記録し、年間の伴走を毎日の記録でつなぐ。' },
        ].map((p) => (
          <div class="border-t-2 border-teal pt-4">
            <p class="font-en font-bold text-ink">{p.name}</p>
            <p class="mt-0.5 text-xs font-medium text-teal">{p.tag}</p>
            <p class="mt-2.5 text-sm leading-relaxed text-ink/60">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink/[0.035]">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center md:px-6 md:py-28">
      <p class="font-en text-xl italic tracking-wide text-teal">Support</p>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink">デジタル導入支援</h2>
      <p class="mx-auto mt-6 max-w-2xl leading-loose text-ink/70">
        チーム・スクール・施設のデジタル化を伴走支援。データの一元管理、動画共有、遠隔でのフィードバックなど、現場の運用に合わせた仕組みづくりを、導入から定着までサポートします。
      </p>
    </div>
  </section>

  <ContactBand />
</Base>
