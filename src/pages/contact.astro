---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="お問い合わせ" description="GRITTYへのご相談・資料請求・無料デモ測定のお申し込みはこちら。フォーム・LINE・メールで受け付けています。">
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="font-en text-xl italic tracking-wide text-teal">Contact</p>
      <h1 class="mt-4 font-display text-4xl font-bold text-ink md:text-5xl">お問い合わせ</h1>
      <p class="mt-6 max-w-2xl leading-loose text-ink/70">
        チームの課題や予算、スケジュールに合わせて最適なプランをご提案いたします。導入検討段階でも、無料デモ測定を受けていただけます。
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 md:grid-cols-[3fr_2fr] md:px-6 md:py-28">
      <div>
        <h2 class="font-display text-xl font-bold text-ink">フォームで相談する</h2>
        <p class="mt-2 text-sm text-ink/50">通常1営業日以内に返信します。</p>
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact/thanks/" class="mt-8 space-y-6">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden"><label>入力しないでください <input name="bot-field" /></label></p>
          <div>
            <label for="name" class="block text-sm font-bold text-ink">お名前 <span class="text-teal">*</span></label>
            <input id="name" name="name" type="text" required class="mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 focus:border-teal focus:bg-white focus:outline-none" />
          </div>
          <div>
            <label for="org" class="block text-sm font-bold text-ink">チーム・団体名</label>
            <input id="org" name="organization" type="text" class="mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 focus:border-teal focus:bg-white focus:outline-none" />
          </div>
          <div>
            <label for="email" class="block text-sm font-bold text-ink">メールアドレス <span class="text-teal">*</span></label>
            <input id="email" name="email" type="email" required class="mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 focus:border-teal focus:bg-white focus:outline-none" />
          </div>
          <div>
            <label for="topic" class="block text-sm font-bold text-ink">ご相談内容</label>
            <select id="topic" name="topic" class="mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 focus:border-teal focus:bg-white focus:outline-none">
              <option>測定・分析の相談</option>
              <option>無料デモ測定の申し込み</option>
              <option>アプリ開発・デジタル導入</option>
              <option>動画制作・YouTube運営</option>
              <option>イベント企画</option>
              <option>その他</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-bold text-ink">メッセージ <span class="text-teal">*</span></label>
            <textarea id="message" name="message" rows="5" required class="mt-2 w-full rounded-lg border border-line bg-white px-4 py-3 focus:border-teal focus:bg-white focus:outline-none"></textarea>
          </div>
          <p class="text-xs leading-relaxed text-ink/60"><a href="/privacy/" class="text-teal underline hover:opacity-80" target="_blank">プライバシーポリシー</a>に同意のうえ送信してください。</p>
          <button type="submit" class="w-full rounded-full bg-navy py-3.5 font-bold text-white transition hover:bg-teal sm:w-auto sm:px-12">送信する</button>
        </form>
      </div>
      <div class="space-y-5">
        <div class="rounded-2xl border border-line bg-white p-6">
          <h3 class="font-display font-bold text-ink">公式LINE</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/60">現場からのご質問にも迅速にお答えします。</p>
          <a href={site.line_url} target="_blank" rel="noopener" class="mt-5 inline-block rounded-full bg-[#06C755] px-7 py-3 text-sm font-bold text-white transition hover:opacity-90">友だち追加</a>
        </div>
        <div class="rounded-2xl border border-line bg-white p-6">
          <h3 class="font-display font-bold text-ink">メール・お電話</h3>
          <p class="mt-3 text-sm leading-loose text-ink/70">
            <a href={`mailto:${site.email}`} class="font-bold text-teal hover:underline">{site.email}</a><br />
            <a href={`tel:${site.tel.replaceAll('-', '')}`} class="font-bold text-teal hover:underline">{site.tel}</a>
          </p>
        </div>
        <div class="rounded-2xl border border-line bg-white p-6">
          <h3 class="font-display font-bold text-ink">無料デモ測定</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/60">
            導入検討段階でも、実際の技術をご体験いただけます。技術を見てからの判断を大切にしています。
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
