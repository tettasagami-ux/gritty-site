---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="お問い合わせ" description="GRITTYへのご相談・資料請求・無料デモ測定のお申し込みはこちら。フォーム・LINE・メールで受け付けています。">
  <section class="bg-ink">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="font-en text-xs font-bold uppercase tracking-[0.3em] text-cyan">Contact</p>
      <h1 class="mt-4 font-display text-4xl font-black text-white md:text-5xl">まずは、<span class="text-cyan">ご相談ください</span>。</h1>
      <p class="mt-5 max-w-2xl leading-relaxed text-white/70">
        チームの課題や予算、スケジュールに合わせて最適なプランをご提案いたします。導入検討段階でも、無料デモ測定を受けていただけます。技術を見てからの判断を大切にしています。
      </p>
    </div>
  </section>

  <section class="bg-cream">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-[2fr_1fr] md:px-6 md:py-24">
      <div class="border border-line bg-white p-6 shadow-sm md:p-8">
        <h2 class="font-display text-xl font-black">フォームで相談する</h2>
        <p class="mt-2 text-sm text-ink/60">通常1営業日以内に返信します。</p>
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact/thanks/" class="mt-6 space-y-5">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden"><label>入力しないでください <input name="bot-field" /></label></p>
          <div>
            <label for="name" class="block text-sm font-bold">お名前 <span class="text-gold">必須</span></label>
            <input id="name" name="name" type="text" required class="mt-1.5 w-full rounded border border-line bg-cream/50 px-3 py-2.5 focus:border-teal focus:outline-none" />
          </div>
          <div>
            <label for="org" class="block text-sm font-bold">チーム・団体名</label>
            <input id="org" name="organization" type="text" class="mt-1.5 w-full rounded border border-line bg-cream/50 px-3 py-2.5 focus:border-teal focus:outline-none" />
          </div>
          <div>
            <label for="email" class="block text-sm font-bold">メールアドレス <span class="text-gold">必須</span></label>
            <input id="email" name="email" type="email" required class="mt-1.5 w-full rounded border border-line bg-cream/50 px-3 py-2.5 focus:border-teal focus:outline-none" />
          </div>
          <div>
            <label for="topic" class="block text-sm font-bold">ご相談内容</label>
            <select id="topic" name="topic" class="mt-1.5 w-full rounded border border-line bg-cream/50 px-3 py-2.5 focus:border-teal focus:outline-none">
              <option>測定・分析の相談</option>
              <option>無料デモ測定の申し込み</option>
              <option>アプリ開発・デジタル導入</option>
              <option>動画制作・YouTube運営</option>
              <option>イベント企画</option>
              <option>その他</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-bold">メッセージ <span class="text-gold">必須</span></label>
            <textarea id="message" name="message" rows="5" required class="mt-1.5 w-full rounded border border-line bg-cream/50 px-3 py-2.5 focus:border-teal focus:outline-none"></textarea>
          </div>
          <button type="submit" class="w-full rounded bg-teal py-3 font-bold text-white transition hover:bg-cyan hover:text-ink sm:w-auto sm:px-10">送信する</button>
        </form>
      </div>
      <div class="space-y-4">
        <div class="border border-line bg-white shadow-sm">
          <div class="h-1.5 bg-cyan"></div>
          <div class="p-5">
            <p class="font-en text-xs font-bold uppercase tracking-widest text-teal">LINE</p>
            <h3 class="mt-1 font-display font-black">公式LINE</h3>
            <p class="mt-2 text-sm text-ink/60">現場からのご質問にも迅速に。</p>
            <a href={site.line_url} target="_blank" rel="noopener" class="mt-4 inline-block rounded bg-[#06C755] px-5 py-2.5 text-sm font-bold text-white transition hover:opacity-90">友だち追加</a>
          </div>
        </div>
        <div class="border border-line bg-white shadow-sm">
          <div class="h-1.5 bg-teal"></div>
          <div class="p-5">
            <p class="font-en text-xs font-bold uppercase tracking-widest text-teal">Email / Tel</p>
            <h3 class="mt-1 font-display font-black">メール・お電話</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink/80">
              <a href={`mailto:${site.email}`} class="font-bold text-teal hover:underline">{site.email}</a><br />
              <a href={`tel:${site.tel.replaceAll('-', '')}`} class="font-bold text-teal hover:underline">{site.tel}</a>
            </p>
          </div>
        </div>
        <div class="border-l-4 border-gold bg-white p-5 text-sm leading-relaxed text-ink/80 shadow-sm">
          <span class="font-bold text-gold">無料デモ測定</span><br />
          導入検討段階でも、実際の技術をご体験いただけます。
        </div>
      </div>
    </div>
  </section>
</Base>
