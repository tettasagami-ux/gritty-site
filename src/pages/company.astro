---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ContactBand from '../components/ContactBand.astro';
import site from '../data/site.json';

const rows = [
  ['会社名', site.company_name],
  ['代表者', '代表取締役　大下 佑馬'],
  ['設立', site.founded],
  ['所在地', site.address],
  ['電話番号', site.tel],
  ['メール', site.email],
  ['事業内容', 'スポーツサイエンス（野球データ分析・フィジカル測定・コンディション管理）／デジタルソリューション（アプリ開発・デジタル導入支援）／クリエイティブ＆イベント（動画制作・YouTube運営・イベント企画運営）'],
];
---
<Base title="会社概要" description="GRITTY株式会社の会社概要。理念・代表メッセージ・会社情報。">
  <section class="border-b border-line bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="font-en text-xs font-bold uppercase tracking-[0.2em] text-teal">Company</p>
      <h1 class="mt-4 font-display text-4xl font-bold text-ink md:text-5xl">会社概要</h1>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
      <SectionHead en="Philosophy" ja="データは、現場で活きて初めて意味を持つ。" />
      <p class="max-w-3xl leading-loose text-ink/70">
        GRITTYはデータを売る会社ではありません。選手と指導者が理解し、納得し、実践できる状態まで伴走する、スポーツ科学のパートナーです。成果を約束せず、数字で過度に売らず。成長するのは選手自身。GRITTYは伴走者です。
      </p>
      <div class="mt-12 grid gap-x-6 gap-y-10 md:grid-cols-3">
        {[
          { t: '現場と科学の二輪', d: 'コーチの経験則と測定データを擦り合わせ、選手ごとの文脈で判断する。' },
          { t: '選手起点の改善設計', d: '「点」ではなく「線」。単発の測定ではなく、課題別メニューを継続的に運用する。' },
          { t: '誠実な伴走', d: '測定して終わりにしない。選手・指導者と同じ目線で、成長のプロセスに寄り添う。' },
        ].map((p) => (
          <div class="border-t-2 border-teal pt-5">
            <h3 class="font-display text-lg font-bold text-ink">{p.t}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink/60">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto grid max-w-6xl items-start gap-12 px-4 py-20 md:grid-cols-[280px_1fr] md:px-6 md:py-28">
      <figure>
        <img src="/images/ceo.webp" alt="GRITTY株式会社 代表取締役 大下佑馬" class="w-full rounded-2xl object-cover" loading="lazy" />
        <figcaption class="mt-4 text-sm font-bold text-ink">大下 佑馬<span class="ml-2 text-xs font-medium text-ink/50">代表取締役</span></figcaption>
      </figure>
      <div>
        <p class="font-en text-xs font-bold uppercase tracking-[0.2em] text-teal">Message</p>
        <h2 class="mt-3 font-display text-2xl font-bold leading-snug text-ink md:text-3xl">{site.message_title}</h2>
        <p class="mt-7 whitespace-pre-line leading-loose text-ink/75">{site.message_body}</p>
        <p class="mt-7 text-sm font-bold text-ink">{site.message_name}</p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
      <SectionHead en="Profile" ja="会社情報" />
      <dl class="divide-y divide-line border-y border-line">
        {rows.map(([k, v]) => (
          <div class="grid gap-1 py-5 sm:grid-cols-[180px_1fr] sm:gap-6">
            <dt class="text-sm font-bold text-ink">{k}</dt>
            <dd class="text-sm leading-relaxed text-ink/70">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <ContactBand />
</Base>
