---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import ContactBand from '../components/ContactBand.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const services = [
  {
    href: '/services/sports-science/',
    en: 'Sports Science Support',
    ja: 'スポーツサイエンスサポート',
    img: '/images/service-science.webp',
    alt: '屋内練習場でハイスピードカメラを設置し打撃を測定する様子',
    desc: 'Rapsodoと1000fpsハイスピードカメラで球質・フォーム・フィジカルを数値化。感覚とデータを結び、選手の成長に伴走します。',
  },
  {
    href: '/services/digital/',
    en: 'Digital Solutions',
    ja: 'デジタルソリューション',
    img: '/images/service-digital.webp',
    alt: 'GRITTY DataBaseの投球分析ダッシュボード画面',
    desc: '現場で本当に使われるアプリを自社開発。計測から記録・育成まで、チームのデジタル化を一気通貫で支えます。',
  },
  {
    href: '/services/creative/',
    en: 'Creative & Events',
    ja: 'クリエイティブ＆イベント',
    img: '/images/service-creative.webp',
    alt: '1000fpsハイスピードカメラで捉えたボールリリースの瞬間',
    desc: '現場の熱量を伝える映像制作と、チーム・スクールの発信を支えるYouTube運営、イベントの企画運営まで。',
  },
];

const cycle = [
  { no: '01', ja: '感覚', desc: '選手自身が感じるイメージや課題感を出発点に。' },
  { no: '02', ja: '計測', desc: 'Rapsodoとカメラで球質・フォーム・フィジカルを数値化。' },
  { no: '03', ja: '仮説・分析', desc: '数値の相関を読み解き、根本的な課題と改善仮説を抽出。' },
  { no: '04', ja: '改善', desc: '選手・指導者が納得感のある個別最適化メニューへ。' },
  { no: '05', ja: '再測定・成長', desc: '小さな変化を数値で確認し、自信と次の仮説へ。' },
];

const products = [
  { name: 'GRITTY DataBase', tag: '投球分析プラットフォーム', desc: '球速・回転数・変化量を可視化し、コーチと選手がデータで投球を最適化。' },
  { name: 'GRITTY Training Management', tag: 'パフォーマンス管理', desc: 'コーチが選手ごとに練習メニューを割り当て、選手がリアルタイムで進捗を記録。' },
  { name: 'GRITTY Conditioning', tag: 'コンディション記録アプリ', desc: '体調・投球数・トレーニング量を記録し、年間の伴走を毎日の記録でつなぐ。' },
];
---
<Base>
  <!-- Hero -->
  <section>
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-16 pt-14 md:grid-cols-[7fr_5fr] md:px-6 md:pb-24 md:pt-20">
      <div>
        <p class="font-en text-xl italic tracking-wide text-teal">Sports Science × Digital × Creative</p>
        <h1 class="mt-5 whitespace-pre-line font-display text-[22px] font-bold leading-[1.75] text-ink sm:text-3xl sm:leading-[1.6] md:text-[24px] lg:text-[33px] lg:leading-[1.55] xl:text-[38px]">{site.hero_catch}</h1>
        <p class="mt-6 max-w-lg leading-loose text-ink/70">{site.hero_sub}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/services/" class="rounded-full bg-navy px-8 py-3.5 font-bold text-white transition hover:bg-teal">事業内容を見る</a>
          <a href="/contact/" class="rounded-full border border-ink/20 px-8 py-3.5 font-bold text-ink transition hover:border-teal hover:text-teal">無料で相談する</a>
        </div>
      </div>
      <div>
        <img src="/images/hero.webp" alt="指導者と選手がタブレットで測定データを一緒に確認している様子" class="w-full rounded-2xl object-cover" loading="eager" />
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="border-y border-line bg-white/60">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 md:flex-row md:items-center md:px-6">
      <p class="shrink-0 font-en text-sm font-bold tracking-wider text-ink md:w-32">NEWS</p>
      <ul class="flex-1 divide-y divide-line md:divide-y-0">
        {news.map((n) => (
          <li>
            <a href={`/news/${n.slug}/`} class="group flex flex-col gap-1.5 py-2.5 sm:flex-row sm:items-center sm:gap-5">
              <time class="font-en text-sm text-ink/40">{fmt(n.data.date)}</time>
              <span class="w-fit rounded-full border border-teal/40 px-2.5 py-0.5 text-xs font-medium text-teal">{n.data.category}</span>
              <span class="text-sm text-ink transition group-hover:text-teal">{n.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/news/" class="shrink-0 text-sm font-bold text-teal hover:underline">一覧を見る →</a>
    </div>
  </section>

  <!-- 理念 -->
  <section>
    <div class="mx-auto max-w-6xl px-4 py-20 text-center md:px-6 md:py-28">
      <p class="font-en text-xl italic tracking-wide text-teal">Philosophy</p>
      <h2 class="mt-5 font-display text-3xl font-bold leading-relaxed text-ink md:text-4xl">
        データは、現場で活きて<br />初めて意味を持つ。
      </h2>
      <p class="mx-auto mt-7 max-w-2xl leading-loose text-ink/70">
        GRITTYはデータを売る会社ではありません。数値は選手の感覚を否定するためではなく、感覚の解像度を上げるためにあります。選手と指導者が理解し、納得し、実践できる状態まで伴走する、スポーツ科学のパートナーです。
      </p>
    </div>
  </section>

  <!-- 3事業 -->
  <section class="bg-ink/[0.035]">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
      <SectionHead en="Service" ja="事業内容" center />
      <div class="grid gap-8 md:grid-cols-3">
        {services.map((s) => (
          <a href={s.href} class="group overflow-hidden rounded-2xl border border-line bg-white transition hover:-translate-y-1 hover:shadow-lg">
            <div class="aspect-[4/3] overflow-hidden">
              <img src={s.img} alt={s.alt} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="p-6">
              <p class="font-en text-lg italic tracking-wide text-teal">{s.en}</p>
              <h3 class="mt-2 font-display text-lg font-bold text-ink">{s.ja}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/60">{s.desc}</p>
              <p class="mt-4 text-sm font-bold text-teal">詳しく見る →</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 測定サイクル -->
  <section class="bg-teal">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
      <SectionHead en="Our Approach" ja="測定を、一度で終わらせない。" center light />
      <p class="mx-auto -mt-6 mb-12 max-w-2xl text-center leading-loose text-white/85">
        GRITTYは「感覚 → 計測 → 分析 → 改善 → 再測定」のサイクルで伴走します。二度目がある測定だけが、選手の成長を裏づけられると考えています。
      </p>
      <ol class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-5">
        {cycle.map((c) => (
          <li>
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white font-en text-sm font-bold text-teal">{c.no}</span>
            <h3 class="mt-3.5 font-display text-lg font-bold text-white">{c.ja}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/75">{c.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- プロダクト -->
  <section class="bg-ink/[0.035]">
    <div class="mx-auto max-w-6xl px-4 py-20 md:px-6 md:py-28">
      <SectionHead en="Products" ja="現場で使う道具を、自社でつくる。" center />
      <div class="mx-auto grid max-w-5xl items-center gap-12 md:grid-cols-[3fr_2fr]">
        <div>
          <img src="/images/dashboard.webp" alt="GRITTY DataBaseの投球分析画面。球種割合・回転効率・球質データの一覧" class="w-full rounded-2xl border border-line bg-white" loading="lazy" />
        </div>
        <div class="space-y-6">
          {products.map((p) => (
            <div class="rounded-xl border border-line bg-white p-5">
              <p class="font-en font-bold text-ink">{p.name}</p>
              <p class="mt-0.5 text-xs font-medium text-teal">{p.tag}</p>
              <p class="mt-2.5 text-sm leading-relaxed text-ink/60">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 代表メッセージ -->
  <section>
    <div class="mx-auto grid max-w-6xl items-start gap-12 px-4 py-20 md:grid-cols-[280px_1fr] md:px-6 md:py-28">
      <figure>
        <img src="/images/ceo.webp" alt="GRITTY株式会社 代表取締役 大下佑馬" class="w-full rounded-2xl object-cover" loading="lazy" />
        <figcaption class="mt-4 text-sm font-bold text-ink">大下 佑馬<span class="ml-2 text-xs font-medium text-ink/50">代表取締役</span></figcaption>
      </figure>
      <div>
        <p class="font-en text-xl italic tracking-wide text-teal">Message</p>
        <h2 class="mt-3 font-display text-2xl font-bold leading-snug text-ink md:text-3xl">{site.message_title}</h2>
        <p class="mt-7 whitespace-pre-line leading-loose text-ink/75">{site.message_body}</p>
        <p class="mt-7 text-sm font-bold text-ink">{site.message_name}</p>
      </div>
    </div>
  </section>

  <ContactBand />
</Base>
