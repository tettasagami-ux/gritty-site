---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

type Item = string | { list: string[] };
const sections: { h: string; body: Item[] }[] = [
  { h: '事業者情報', body: [{ list: [`名称：${site.company_name}`, '代表者：代表取締役　大下 佑馬', `所在地：${site.address}`, `お問い合わせ：${site.email}`] }] },
  { h: '取得する個人情報', body: ['当社は、本サービスの提供にあたり、以下の情報を取得することがあります。', { list: [
    'お問い合わせ・お申し込み時にご提供いただく情報（氏名、所属チーム・学校名、メールアドレス、電話番号、ご相談内容など）',
    '公式LINEアカウントを通じて取得する情報（LINEの表示名、プロフィール画像、ユーザー識別子、メッセージの内容など）',
    '測定・サポートの実施にあたり取得する情報（年齢、身長・体重等の身体情報、投球・打撃等の測定データ、フォーム撮影映像、トレーニング・コンディションの記録など）',
    '当社アプリのご利用にあたり取得する情報（アカウント情報、入力された記録データ、利用履歴など）',
    'ウェブサイトの閲覧に伴い取得する情報（Cookie、IPアドレス、ブラウザの種類、閲覧履歴など）',
  ] }] },
  { h: '利用目的', body: ['当社は、取得した個人情報を以下の目的で利用します。', { list: [
    'お問い合わせへの回答およびご連絡のため',
    '測定・分析・トレーニング提案等の本サービスを提供するため',
    '当社アプリの提供、運営、本人確認およびサポートのため',
    '本サービスに関するお知らせ、イベント等のご案内のため',
    '本サービスの改善および新サービスの開発のため（個人を特定できない形に加工した統計データとして利用する場合を含みます）',
    '利用規約等に違反する行為への対応のため',
    'その他、上記の利用目的に付随する目的のため',
  ] }] },
  { h: '映像・画像の取扱い', body: ['測定時に撮影したフォーム映像等は、分析およびフィードバックの目的に限り利用します。ウェブサイト、SNS、YouTube等での公開や事例紹介に利用する場合は、事前にご本人（未成年の場合は保護者）の同意を得たうえで行います。'] },
  { h: '未成年者の個人情報', body: ['本サービスの利用者が未成年の場合、当社は保護者または指導者の同意を得たうえで個人情報を取得・利用します。'] },
  { h: '要配慮個人情報', body: ['当社は、コンディション管理等において、体調や怪我の状況など健康に関する情報を取り扱う場合があります。これらの情報を取得する際は、あらかじめご本人（未成年の場合は保護者）の同意を得るものとし、本サービスの提供に必要な範囲でのみ利用します。'] },
  { h: '第三者提供', body: ['当社は、次の場合を除き、あらかじめご本人の同意を得ることなく個人情報を第三者に提供しません。', { list: [
    '法令に基づく場合',
    '人の生命、身体または財産の保護のために必要がある場合であって、ご本人の同意を得ることが困難な場合',
    '公衆衛生の向上または児童の健全な育成の推進のために特に必要がある場合であって、ご本人の同意を得ることが困難な場合',
    '国の機関もしくは地方公共団体またはその委託を受けた者が法令の定める事務を遂行することに対して協力する必要がある場合',
  ] }, 'なお、チームや学校との契約に基づき測定を実施する場合、測定結果を当該チームの指導者に共有することがあります。この場合は、事前にその旨をご案内します。'] },
  { h: '業務委託', body: ['当社は、利用目的の達成に必要な範囲で、個人情報の取扱いの全部または一部を外部に委託することがあります（システムの保守・運用、サーバーの管理など）。この場合、委託先を適切に選定し、必要かつ適切な監督を行います。'] },
  { h: '安全管理措置', body: ['当社は、個人情報の漏えい、滅失または毀損を防止するため、アクセス権限の管理、通信の暗号化、従業者への教育など、必要かつ適切な安全管理措置を講じます。'] },
  { h: 'Cookie・アクセス解析', body: ['当社ウェブサイトでは、利便性の向上および利用状況の把握のため、Cookieおよびアクセス解析ツールを利用することがあります。これらにより個人を特定する情報を取得することはありません。Cookieはブラウザの設定により無効にすることができます。'] },
  { h: '開示・訂正・利用停止等の請求', body: ['ご本人から、個人情報の利用目的の通知、開示、訂正、追加、削除、利用停止または第三者提供の停止のご請求があった場合、ご本人であることを確認したうえで、法令に従い遅滞なく対応します。ご請求は下記のお問い合わせ窓口までご連絡ください。'] },
  { h: '本ポリシーの変更', body: ['当社は、法令の改正や事業内容の変更に応じて、本ポリシーを変更することがあります。変更後の本ポリシーは、本ウェブサイトに掲載した時点から効力を生じるものとします。'] },
  { h: 'お問い合わせ窓口', body: ['本ポリシーおよび個人情報の取扱いに関するお問い合わせは、以下までご連絡ください。', { list: [site.company_name, `メール：${site.email}`] }] },
];
---
<Base title="プライバシーポリシー" description="GRITTY株式会社の個人情報の取扱いについて。">
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
      <p class="font-en text-xl italic tracking-wide text-teal">Privacy Policy</p>
      <h1 class="mt-4 font-display text-4xl font-bold text-ink md:text-5xl">プライバシーポリシー</h1>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24">
      <p class="leading-loose text-ink/75">
        {site.company_name}（以下「当社」）は、当社が提供するスポーツサイエンスサポート、デジタルソリューション、クリエイティブ＆イベントの各サービス、ならびに当社ウェブサイトおよび公式LINEアカウント（以下総称して「本サービス」）における個人情報の取扱いについて、以下のとおりプライバシーポリシー（以下「本ポリシー」）を定めます。
      </p>

      {sections.map((s, i) => (
        <div class="mt-12 border-t border-line pt-8">
          <h2 class="font-display text-xl font-bold text-ink md:text-2xl">
            <span class="mr-3 font-en text-teal">{String(i + 1).padStart(2, '0')}</span>{s.h}
          </h2>
          {s.body.map((b) =>
            typeof b === 'string' ? (
              <p class="mt-4 text-sm leading-loose text-ink/75 md:text-base">{b}</p>
            ) : (
              <ul class="mt-4 list-disc space-y-2 pl-6 text-sm leading-relaxed text-ink/75 md:text-base">
                {b.list.map((li) => <li>{li}</li>)}
              </ul>
            )
          )}
        </div>
      ))}

      <p class="mt-16 text-right text-sm text-ink/60">制定日：2026年9月24日</p>
    </div>
  </section>
</Base>
